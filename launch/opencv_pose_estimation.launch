<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="prefix" default="/hsrb" />
  <arg name="model_file" default="$(find final-project-OfficialBishal)/config/opencv_model_mustard.yml" />
  <arg name="image_topic" default="/hsrb/head_rgbd_sensor/rgb/image_rect_color" />
  <arg name="camera_info_topic" default="/hsrb/head_rgbd_sensor/rgb/camera_info" />
  <arg name="frame_id" default="head_rgbd_sensor_rgb_frame" />
  
  <!-- OpenCV Pose Estimation node -->
  <node name="opencv_pose_estimation" pkg="final-project-OfficialBishal" type="opencv_pose_estimation_node" output="screen">
    <param name="model_file" value="$(arg model_file)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="num_keypoints" value="2000" />
    <param name="ratio_test" value="0.7" />
    <param name="ransac_iterations" value="500" />
    <param name="ransac_reprojection_error" value="2.0" />
    <param name="ransac_confidence" value="0.95" />
    <param name="min_inliers_kalman" value="30" />
  </node>
</launch>

